#!/bin/bash
# One45 Schedule Wrangler.app: Finder runs this on double-click.
# No Terminal is attached, so every message is a dialog or a notification.
# Finder gives apps a bare PATH, so Python is found by its python.org path.
# build.sh puts wrangler.py, wrangler_gui.py, setup-venv.sh and requirements.txt
# in Contents/Resources, so the app is complete on its own. Nothing is written
# inside the bundle: Gatekeeper runs a quarantined app from a read-only copy
# (App Translocation), so the venv and the lock live in Application Support.
# tests/test_launcher.py drives this with WRANGLER_RESOURCES and
# WRANGLER_FRAMEWORKS set, and stand-ins for osascript, curl, pkgutil and open on PATH.
set -euo pipefail

APP_NAME="One45 Schedule Wrangler"

# The newest python.org release with a macOS installer is offered, so a new
# Mac gets the current Python and Tk. When python.org's folder listing can't
# be read, this release is offered instead. Either way the download is opened
# only if Apple's pkgutil finds the Python Software Foundation's Developer ID
# signature on it, which a pinned checksum could only do for one release.
PYTHON_FTP="https://www.python.org/ftp/python"
PYTHON_FALLBACK_VERSION="3.14.10"
PYTHON_MIN_MINOR=10  # 3.10+: find_python's probe below says the same
# Finder's PATH has /usr/sbin, but the test harness stands this in.
PKGUTIL="${WRANGLER_PKGUTIL:-/usr/sbin/pkgutil}"
PYTHON_SIGNED_STATUS="Status: signed by a developer certificate issued by Apple"
PYTHON_SIGNER="Developer ID Installer: Python Software Foundation (BMM5U3QVKW)"

RESOURCES="${WRANGLER_RESOURCES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources" && pwd)}"
FRAMEWORKS="${WRANGLER_FRAMEWORKS:-/Library/Frameworks/Python.framework/Versions}"
SUPPORT_DIR="$HOME/Library/Application Support/$APP_NAME"
VENV_DIR="$SUPPORT_DIR/venv"
VENV_PY="$VENV_DIR/bin/python"
LOG_DIR="$HOME/Library/Logs/$APP_NAME"
SETUP_LOG="$LOG_DIR/setup.log"
RUN_LOG="$LOG_DIR/window.log"
LOCK="$SUPPORT_DIR/setup.lock"
# The venv outlives app versions, so what it was built from is kept beside it.
REQUIREMENTS="$RESOURCES/requirements.txt"
INSTALLED_REQUIREMENTS="$SUPPORT_DIR/installed-requirements.txt"

say() {  # say "text" [icon]; a dismissed dialog must not stop the script
  osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"$APP_NAME\" with icon ${2:-note}" >/dev/null 2>&1 || true
}

ask() {  # ask "text" "Button": true when that button was pressed
  local answer
  answer="$(osascript -e "display dialog \"$1\" buttons {\"Cancel\", \"$2\"} default button \"$2\" with title \"$APP_NAME\" with icon note" 2>/dev/null)" || return 1
  [[ "$answer" == *"$2"* ]]
}

notify() {
  osascript -e "display notification \"$1\" with title \"$APP_NAME\"" >/dev/null 2>&1 || true
}

# Newest python.org Python that is 3.10+ and has Tkinter. Apple's /usr/bin/python3
# is never used: without the developer tools it only shows an install prompt.
find_python() {
  local version py
  [[ -d "$FRAMEWORKS" ]] || return 1
  while read -r version; do
    py="$FRAMEWORKS/$version/bin/python3"
    if [[ -x "$py" ]] && "$py" -c 'import sys, tkinter; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
      echo "$py"
      return 0
    fi
  done < <(ls -1 "$FRAMEWORKS" | grep -E '^3\.[0-9]+$' | sort -V -r)
  return 1
}

python_pkg_url() {
  echo "$PYTHON_FTP/$1/python-$1-macos11.pkg"
}

# Newest Python 3.10+ release whose macOS installer exists. A release's folder
# appears with its first alpha, so the newest folders may hold no final
# installer yet; each is asked for one, newest first, eight at most. A new
# x.y.0 is offered as soon as its installer is: the app's needs are plain.
latest_python_version() {
  local listing version
  listing="$(curl -fsSL --max-time 20 "$PYTHON_FTP/")" || return 1
  while read -r version; do
    if curl -fsI --max-time 20 -o /dev/null "$(python_pkg_url "$version")" 2>/dev/null; then
      echo "$version"
      return 0
    fi
  done < <(grep -oE 'href="3\.[0-9]+\.[0-9]+/"' <<<"$listing" | grep -oE '3\.[0-9]+\.[0-9]+' \
           | awk -F. -v min="$PYTHON_MIN_MINOR" '$2 >= min' | sort -urV | head -8)
  return 1
}

install_python() {
  # Nothing goes over the network before the person agrees.
  ask "Python from python.org isn't installed on this Mac. (Other Pythons can't open the window.) Download the newest Python, about 80 MB, and run its installer?" "Download" || exit 1
  local version url pkg
  notify "Finding the newest Python..."
  version="$(latest_python_version)" || version="$PYTHON_FALLBACK_VERSION"
  url="$(python_pkg_url "$version")"
  local dir="${TMPDIR:-/tmp}/one45-schedule-wrangler"
  pkg="$dir/$(basename "$url")"
  mkdir -p "$dir"
  notify "Downloading Python $version..."
  # A stalled download must reach the failure dialog, not hang unseen.
  if ! curl -fsSL -o "$pkg" --connect-timeout 20 --speed-limit 1000 --speed-time 60 "$url"; then
    say "The download failed. Check the internet connection and try again, or install Python from python.org/downloads yourself." caution
    exit 1
  fi
  # A tampered package reports "Status: package is invalid" and no chain; both
  # the valid status and the signer are required all the same.
  local signature
  signature="$("$PKGUTIL" --check-signature "$pkg" 2>/dev/null || true)"
  if ! grep -qF "$PYTHON_SIGNED_STATUS" <<<"$signature" || ! grep -qF "$PYTHON_SIGNER" <<<"$signature"; then
    rm -f "$pkg"
    say "The downloaded Python installer is not signed by the Python Software Foundation, so it was not opened. Install Python from python.org/downloads yourself." caution
    exit 1
  fi
  say "The Python installer will open now. When it finishes, open $APP_NAME again."
  open "$pkg"
  exit 0
}

# One setup at a time: a second double-click during the first open must not
# start another pip install into the same venv. A lock left by a dead process
# (power loss, force quit) is taken over.
take_setup_lock() {
  local pid
  pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
  # A lock without a readable pid is stale too; `kill -0 0` would hit our own group.
  if [[ -d "$LOCK" && "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null; then
    say "$APP_NAME is still setting up from an earlier open. Give it a minute, then open it again."
    exit 1
  fi
  rm -rf "$LOCK"
  mkdir "$LOCK"
  echo $$ > "$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT
}

if [[ ! -f "$RESOURCES/wrangler_gui.py" || ! -f "$RESOURCES/setup-venv.sh" || ! -f "$REQUIREMENTS" ]]; then
  say "This copy of $APP_NAME is incomplete. Download the app again from the latest release. (In a checkout, run ./build.sh and open the app in dist/.)" caution
  exit 1
fi

mkdir -p "$LOG_DIR" "$SUPPORT_DIR"

# First open, a new version with different requirements, or a Python upgrade
# that broke the venv: build it.
if [[ ! -x "$VENV_PY" ]] || ! cmp -s "$REQUIREMENTS" "$INSTALLED_REQUIREMENTS" \
    || ! "$VENV_PY" -c 'import openpyxl, tkinter' >/dev/null 2>&1; then
  PY="$(find_python)" || install_python
  take_setup_lock
  notify "Setting up $APP_NAME (first open only)..."
  if ! PYTHON="$PY" VENV_DIR="$VENV_DIR" "$RESOURCES/setup-venv.sh" >"$SETUP_LOG" 2>&1; then
    say "Setup did not finish. Details are in $SETUP_LOG" caution
    exit 1
  fi
  cp "$REQUIREMENTS" "$INSTALLED_REQUIREMENTS"
fi

# Not exec: a crash at startup would otherwise vanish without a trace.
# -B: no __pycache__ inside the bundle.
if ! "$VENV_PY" -B "$RESOURCES/wrangler_gui.py" 2>"$RUN_LOG"; then
  say "$APP_NAME closed with an error. Details are in $RUN_LOG" caution
  exit 1
fi
